# ── Salin file ini menjadi .env ──

# ── [1] TAHAPAN OPERASIONAL ──
AGENT_MODE=paper              # Pilihan: 'paper' atau 'live'
LOG_LEVEL=INFO                # Pilihan: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json               # Pilihan: json, text

# ── [2] EXCHANGES (Binance) ──
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false
CCXT_RETRIES=3

# ── [3] TRADING STRATEGY ──
SYMBOLS=BTCUSDT,ETHUSDT       # Pisahkan dengan koma
TIMEFRAME=1h                  # Standar: 1h, 4h, 15m
INITIAL_EQUITY=10000.0        # Default modal simulasi

# ── [4] RISK MANAGEMENT ──
RISK_PER_TRADE_PCT=0.01       # 1% dari total modal
MAX_DAILY_LOSS_PCT=0.05       # 5% dari modal awal hari tersebut
MAX_DRAWDOWN_PCT=0.10         # 10% dari all-time high balance
MAX_OPEN_POSITIONS=5
LEVERAGE_MAX=3                # Jika bermain di Futures

# ── [5] KECERDASAN BUATAN (LLM Filter) ──
LLM_ENABLED=false             # Ubah ke true untuk menyalakan AI Filter
ANTHROPIC_API_KEY=sk-ant-your_claude_key
# OPENAI_API_KEY=sk-your_openai_key
# GEMINI_API_KEY=your_gemini_key

LLM_DAILY_BUDGET_USD=0.05     # Batas pengeluaran harian API LLM ($) sangat rendah untuk meminimalisir biaya

# ── [6] NOTIFIKASI TELEGRAM & DISCORD ──
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_hook

# ── [7] OBSERVABILITY (GRAFANA & PROMETHEUS) ──
METRICS_PORT=8090
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=15d
